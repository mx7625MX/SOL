# Solana RPC节点配置
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
WS_ENDPOINT=wss://api.mainnet-beta.solana.com

# 钱包私钥 (Base58格式)
PRIVATE_KEY=your_private_key_here

# 交易配置
MAX_BUY_AMOUNT=0.1
MIN_BUY_AMOUNT=0.01
SLIPPAGE_BPS=500

# pump.fun配置
PUMPFUN_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
PUMPFUN_API=https://frontend-api.pump.fun

# 其他配置
GAS_PRIORITY_FEE=0.0001
AUTO_SELL=false
SELL_PROFIT_PERCENTAGE=50
STOP_LOSS_PERCENTAGE=20

# ============================================
# 利润监控机器人配置 (pump_profit_bot.py)
# ============================================

# 止盈配置
PROFIT_PERCENTAGE=30          # 利润达到此百分比时自动卖出

# 鲸鱼监控配置
WHALE_BUY_THRESHOLD=1.0       # 检测到其它钱包买入超过此金额(SOL)时触发卖出

# 卖出配置
SELL_RATIO=100                # 卖出比例 (10-100%), 100=全部卖出
MAX_EXECUTION_DELAY=2.0       # 最大执行延迟(秒), 默认2秒
